# Copy to .env and fill in. Never commit .env.

# Postgres (matches compose.yml)
DATABASE_URL=postgresql+psycopg://finrecur:finrecur@localhost:5432/finrecur

# Anthropic. Optional: without it the workflow runs and clusters show
# "Grouped by code · not yet explained". Get one at console.anthropic.com.
ANTHROPIC_API_KEY=

# Demo mode applies data/faults.json at seed time. Leave true for the demo.
FINRECUR_DEMO=true

# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# Web -> API
NEXT_PUBLIC_API_URL=http://localhost:8000
